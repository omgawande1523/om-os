# Copy to .env.local for local development. Never commit real keys.

# Web3Forms access key for the contact form (https://web3forms.com → "Create Access Key").
# Without it the form falls back to opening the visitor's email app (mailto:).
VITE_WEB3FORMS_KEY=

# Optional: GitHub token for scripts/snapshot-github.mjs (raises the API rate limit).
# A fine-grained token with no extra permissions (public data only) is enough.
GITHUB_TOKEN=
